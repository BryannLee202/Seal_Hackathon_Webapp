{
  "name": "seal-hackathon-bff",
  "version": "1.0.0",
  "description": "BFF (Backend-For-Frontend) layer between the React frontend and the Spring Boot API for SEAL Hackathon Management System",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "start:debug": "tsc-watch -p tsconfig.json --onSuccess \"node --inspect dist/main.js\""
  },
  "dependencies": {
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "axios": "^1.7.9",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.7.2"
  }
}
